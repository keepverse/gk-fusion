<ui:FluentWindow x:Class="FusionRpg.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Garden Keeper and his Multiverse"
        Width="920" Height="640"
        MinWidth="720" MinHeight="480"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Closing="OnClosing">
  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="Garden Keeper and his Multiverse" Grid.Row="0" />

    <Grid Grid.Row="1" Margin="20,8,20,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Status lights -->
      <Border Grid.Row="0" Padding="12" CornerRadius="8" Background="#22FFFFFF" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Ellipse x:Name="ServerLight" Width="14" Height="14" Fill="Gray" Margin="0,0,8,0" />
            <TextBlock x:Name="ServerStatusText" Text="Server: —" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Ellipse x:Name="GameLight" Width="14" Height="14" Fill="Gray" Margin="0,0,8,0" />
            <TextBlock x:Name="GameStatusText" Text="Game: —" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Ellipse x:Name="InjectorLight" Width="14" Height="14" Fill="Gray" Margin="0,0,8,0" />
            <TextBlock x:Name="InjectorStatusText" Text="Injector: —" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="3" x:Name="UrlText" Text="URL: —" VerticalAlignment="Center" FontWeight="SemiBold" />
        </Grid>
      </Border>

      <!-- Game folder -->
      <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="True">
        <ui:Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseGame_Click" Margin="8,0,0,0" Appearance="Secondary" />
        <StackPanel>
          <TextBlock Text="Game folder (contains PlantsVsZombiesRH.exe)" Opacity="0.7" Margin="0,0,0,4" />
          <ui:TextBox x:Name="GameFolderBox" PlaceholderText="Select game folder…" />
        </StackPanel>
      </DockPanel>

      <!-- Main body: disk + log -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Requirements" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock x:Name="LoaderText" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.9" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <ui:Button x:Name="InstallBepButton" Content="Install BepInEx 6 (IL2CPP)" Click="InstallBep_Click" Appearance="Secondary" Margin="0,0,8,0"
                         ToolTip="PVZ Fusion is Unity IL2CPP. Installs pinned BepInEx 6 IL2CPP from GitHub — not Mono 5.4.x (that will not work)." />
              <ui:Button x:Name="InstallMelonButton" Content="Install MelonLoader" Click="InstallMelon_Click" Appearance="Secondary" />
            </StackPanel>
            <ui:Button x:Name="InstallPluginButton" Content="Install FusionRpg plugin"
                       Click="InstallPlugin_Click" Appearance="Primary" Margin="0,0,0,12"
                       ToolTip="Copies DropIntoGame\\BepInEx or DropIntoGame\\MelonLoader into the active loader plugin folder (required to play)." />

            <TextBlock Text="Disk / database" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock x:Name="DiskText" TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.9" />

            <TextBlock x:Name="UpdateBanner" TextWrapping="Wrap" Margin="0,0,0,6"
                       Foreground="#FFD27A" Visibility="Collapsed" />
            <ui:Button x:Name="UpdateButton" Content="Download &amp; install FusionRpg update" Click="UpdateFusionRpg_Click"
                       Appearance="Primary" Margin="0,0,0,8" Visibility="Collapsed" />
            <ui:Button x:Name="CancelBusyButton" Content="Cancel" Click="CancelBusy_Click"
                       Appearance="Secondary" Margin="0,0,0,12" Visibility="Collapsed" />

            <TextBlock Text="Trust" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock x:Name="TrustStatusText" TextWrapping="Wrap" Margin="0,0,0,6" Opacity="0.9"
                       Text="Unsigned hobby build — acknowledge trust to Play." />
            <ui:Button x:Name="PrepareSecurityButton" Content="Prepare Windows Security"
                       Click="PrepareWindowsSecurity_Click" Appearance="Secondary" Margin="0,0,0,12"
                       ToolTip="UAC: add Microsoft Defender exclusion for this folder (not Bitdefender)." />

            <TextBlock Text="Links" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ui:HyperlinkButton Content="GitHub repo / guide" Click="OpenRepo_Click" Padding="0" />
            <ui:HyperlinkButton Content="Releases" Click="OpenReleases_Click" Padding="0" />
            <ui:HyperlinkButton Content="Open RPG UI" Click="OpenUi_Click" Padding="0" Margin="0,4,0,0" />
            <ui:HyperlinkButton Content="Open loader log" Click="OpenBepLog_Click" Padding="0" Margin="0,4,0,0" />
            <ui:HyperlinkButton Content="Open server folder" Click="OpenServerFolder_Click" Padding="0" Margin="0,4,0,0" />
            <ui:HyperlinkButton Content="Trust &amp; security" Click="TrustSecurity_Click" Padding="0" Margin="0,4,0,0" />
            <ui:HyperlinkButton Content="About / AGPL" Click="About_Click" Padding="0" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="1">
          <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                   Background="#18000000" BorderThickness="1" />
        </DockPanel>
      </Grid>

      <!-- Actions -->
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <ui:Button Content="Uninstall plugin" Click="Uninstall_Click" Appearance="Secondary" Margin="0,0,8,0" />
        <ui:Button Content="Restart game" Click="RestartGame_Click" Appearance="Secondary" Margin="0,0,8,0" />
        <ui:Button Content="Restart server" Click="RestartServer_Click" Appearance="Secondary" Margin="0,0,8,0" />
        <ui:Button Content="Stop all" Click="StopAll_Click" Appearance="Secondary" Margin="0,0,8,0" />
        <ui:Button x:Name="OverlayButton" Content="Overlay (F10)" Click="Overlay_Click" Appearance="Secondary" Margin="0,0,8,0"
                   ToolTip="Toggle the in-game web overlay. Global hotkey works while the game has focus." />
        <ui:Button x:Name="PlayButton" Content="Play" Click="Play_Click" Appearance="Primary" MinWidth="100" />
      </StackPanel>
    </Grid>

    <StatusBar Grid.Row="2" Height="28">
      <StatusBarItem>
        <TextBlock x:Name="StatusBarText" Text="Ready" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</ui:FluentWindow>
