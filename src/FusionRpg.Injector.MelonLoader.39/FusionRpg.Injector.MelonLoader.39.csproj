<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MelonLoader host for matrix cell pvzrh-3.9 (Int64 zombie HP). Shares Melon entry + shared
    injector. The cell table and the pack-root rules live in Directory.Build.props; the sibling
    project FusionRpg.Injector.MelonLoader serves cell pvzrh-3.8.1.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FusionRpg.Injector.MelonLoader.39</AssemblyName>
    <RootNamespace>FusionRpg.Injector</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DefineConstants>$(DefineConstants);FUSIONRPG_MELON</DefineConstants>
    <HasMelonRefs Condition="'$(MlGameDir)' != '' and Exists('$(MlGameDir)\MelonLoader\net6\MelonLoader.dll') and Exists('$(MlGameDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll')">true</HasMelonRefs>
    <HasMelonRefs Condition="'$(HasMelonRefs)' == ''">false</HasMelonRefs>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo Condition="'$(HasMelonRefs)' != 'true'">false</GenerateAssemblyInfo>
    <OutputPath Condition="'$(HasMelonRefs)' == 'true' and '$(OutputPath)' == ''">$(MlGameDir)\Mods\</OutputPath>
    <AssemblyTitle>FusionRpg MelonLoader Injector (pvzrh-3.9)</AssemblyTitle>
    <Product>FusionRpg</Product>
    <Description>FusionRpg MelonLoader host for PVZ Fusion 3.9</Description>
    <Version>0.1.2</Version>
    <InformationalVersion>0.1.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="WarnSkipMelon39" BeforeTargets="Build" Condition="'$(HasMelonRefs)' != 'true'">
    <Message Importance="high"
             Text="NOT COMPILED — skipping FusionRpg.Injector.MelonLoader.39. Cell pvzrh-3.9 x MelonLoader has no pack root: set FUSIONRPG_ML_GAMEDIR_PVZRH_3_9 to a pvzrh-3.9 MelonLoader pack (MelonLoader\net6\MelonLoader.dll + MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll), or pass -p:MlGameDir=&lt;pack&gt; from a caller that already knows the cell. FUSIONRPG_ML_GAMEDIR is loader-wide and serves both MelonLoader cells (pvzrh-3.8.1, pvzrh-3.9), so it cannot say which one it holds and is not read by either cell." />
  </Target>

  <ItemGroup Condition="'$(HasMelonRefs)' != 'true'">
    <Compile Include="..\FusionRpg.Injector.MelonLoader\SkipStub.cs" Link="SkipStub.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(HasMelonRefs)' == 'true'">
    <Compile Include="..\FusionRpg.Injector.MelonLoader\MelonFusionRpgMod.cs" Link="MelonFusionRpgMod.cs" />
    <Compile Include="..\FusionRpg.Injector.MelonLoader\GlobalUsings.Il2Cpp.cs" Link="GlobalUsings.Il2Cpp.cs" />
    <Compile Include="..\FusionRpg.Injector\**\*.cs"
             Exclude="..\FusionRpg.Injector\obj\**;..\FusionRpg.Injector\bin\**;..\FusionRpg.Injector\Bridges\**" />
    <!-- Bridges are chosen by the CELL (pvzrh-3.9), never by FUSIONRPG_GAME_PROFILE: the Blooms
         3.8.1 pack gives zombie HP as Int32 and this cell's bridge reads it as Int64. -->
    <Compile Include="..\FusionRpg.Injector\Bridges\$(FusionRpgCellProfile)\**\*.cs" />
    <ProjectReference Include="$(GkCoreRoot)src\FusionRpg.Contracts\FusionRpg.Contracts.csproj" />
    <ProjectReference Include="$(GkCoreRoot)src\FusionRpg.Core\FusionRpg.Core.csproj" />
    <ProjectReference Include="$(GkCoreRoot)src\FusionRpg.CheatCore\FusionRpg.CheatCore.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="6.0.36" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- In-game overlay host (overlayHost=injector). Ships the loader shim only; Chromium is the machine-wide Evergreen runtime. -->
    <!-- tunables-ssot.md §7.2: RpgHost.Initialize loads data/tuning/ next to the built mod. -->
    <Content Include="$(GkCoreRoot)data\tuning\**\*.json">
      <Link>data\tuning\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- catalog-runtime's Injector-side flip (seed-to-concrete, 2026-09-06): the real 829-species
         committed tree, read by ConcreteSpeciesSeedReader (Core-only, no SQL) via RpgHost.Initialize
         the same way data/tuning/ already reaches this same folder. Excludes the two underscore-
         prefixed aggregate files (_species-build-plan.json, _fusion-recipes.json) — neither is a
         per-species ConcreteSpecies row the reader can parse. -->
    <Content Include="$(GkDataRoot)packs\fusion\data\generated\creatures\*.json" Exclude="$(GkDataRoot)packs\fusion\data\generated\creatures\_*.json">
      <Link>data\generated\creatures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- RpgHost.Initialize reads these two authored registries straight off the plugin dir
         (party-dungeon D1.4's DungeonRegistryLoader.LoadAll, commander-identity SE4.3's
         DataCommanderDirectory.Parse), and neither host copied them, so a fresh game install crashed
         with DirectoryNotFoundException on 'data/seed/commanders/_registry/default-commanders.v1.json'
         before this Content item existed (found live 2026-09-20, B27/BP4 live-qa probe). -->
    <Content Include="$(GkDataRoot)packs\fusion\data\seed\dungeon\_registry\*.json">
      <Link>data\seed\dungeon\_registry\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(GkDataRoot)packs\fusion\data\seed\commanders\_registry\*.json">
      <Link>data\seed\commanders\_registry\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- identity-rename T12: the commander registry names its antagonist by token, so the
         injector resolves it through the lead-names registry beside the plugin. -->
    <Content Include="$(GkDataRoot)packs\fusion\data\seed\narrative\_registry\*.json">
      <Link>data\seed\narrative\_registry\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Same menu overlay asset as the 3.8 MelonLoader twin. -->
    <Content Include="$(GkWebRoot)web\fusion-rpg-web\public\assets\onboarding\rift-portal-pvz-style.png">
      <Link>assets\onboarding\rift-portal-pvz-style.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\FusionRpg.Injector\Assets\actor-hud-elements\**\*.png">
      <Link>assets\actor-hud-elements\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="..\FusionRpg.Injector\Assets\elemental-action-vfx\earth\v2\impact-128x128.png">
      <LogicalName>FusionRpg.Injector.Assets.ElementalActionVfx.Earth.V2.impact-128x128.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\FusionRpg.Injector\Assets\elemental-action-vfx\earth\v2\impact-256x256.png">
      <LogicalName>FusionRpg.Injector.Assets.ElementalActionVfx.Earth.V2.impact-256x256.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\FusionRpg.Injector\Assets\elemental-action-vfx\earth\v2\impact-512x512.png">
      <LogicalName>FusionRpg.Injector.Assets.ElementalActionVfx.Earth.V2.impact-512x512.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\FusionRpg.Injector\Assets\elemental-action-vfx\earth\charge-256x256.png">
      <LogicalName>FusionRpg.Injector.Assets.ElementalActionVfx.Earth.charge-256x256.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\FusionRpg.Injector\Assets\elemental-action-vfx\earth\travel-256x64.png">
      <LogicalName>FusionRpg.Injector.Assets.ElementalActionVfx.Earth.travel-256x64.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(HasMelonRefs)' == 'true'">
    <Reference Include="0Harmony">
      <HintPath>$(MlGameDir)\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MelonLoader">
      <HintPath>$(MlGameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MlGameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(MlGameDir)\MelonLoader\net6\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(MlGameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!--
    The WebView2 package ships WPF/WinForms wrappers, XML docs and arm64/x86 natives. We use only
    Core plus the x64 loader, and everything here lands in the player's game folder, so drop the
    rest rather than shipping ~1.1 MB of unused payload into a modded IL2CPP install.
  -->
  <Target Name="TrimWebView2Payload" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Extension)' == '.xml' AND $([System.String]::new('%(Filename)').StartsWith('Microsoft.Web.WebView2'))" />
      <ReferenceCopyLocalPaths
        Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' OR '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <!--
    RID-specific natives resist item-group filtering (they are injected late by the SDK), so sweep
    them from the output after the copy. The game is win-x64 only; arm64/x86 loaders would just sit
    in the player's plugin folder looking like something they should worry about.
  -->
  <Target Name="TrimWebView2Natives" AfterTargets="Build">
    <!--
      Flatten the x64 loader next to the managed DLL. publish-player copies the plugin folder with
      a top-level-files-only sweep, so anything under runtimes\ silently misses the player pack and
      the in-game view degrades to "loader not found". Flat also matches where a reader expects it.
    -->
    <ItemGroup>
      <_Wv2X64Loader Include="@(RuntimeTargetsCopyLocalItems)"
                     Condition="'%(Filename)%(Extension)' == 'WebView2Loader.dll' AND $([System.String]::new('%(Identity)').Contains('win-x64'))" />
    </ItemGroup>
    <!-- Sourced from the package, not from $(OutputPath): an incremental build may not re-copy natives. -->
    <Copy SourceFiles="@(_Wv2X64Loader)" DestinationFolder="$(OutputPath)" ContinueOnError="true" />
    <ItemGroup>
      <_Wv2Runtimes Include="$(OutputPath)runtimes\**\*" />
    </ItemGroup>
    <Delete Files="@(_Wv2Runtimes)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutputPath)runtimes" ContinueOnError="true" />
  </Target>
</Project>
